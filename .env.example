# Encryption password for the `escola-auth` session cookie, read by
# `sessionConfig()` in `src/lib/auth.server.ts`. Must be >= 32 bytes of
# high-entropy randomness (`openssl rand -base64 32`). Also required in Vercel
# Production AND Preview. See docs/framework/tech-stack.md § Secrets.
SESSION_SECRET=""

SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# === AIOX Variables (added 2026-09-10) ===
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Get your key at: https://exa.ai/
EXA_API_KEY=
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=
SUPABASE_ANON_KEY=
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=
# Sentry (error tracking)
SENTRY_DSN=
# Railway (deployment)
RAILWAY_TOKEN=
# Vercel (deployment)
VERCEL_TOKEN=
# --------------------------------------------
NODE_ENV=development
AIOX_VERSION=5.4.1

# AIOX_NOTE: The following variables already exist with different values:
# AIOX_SUGGESTED: SUPABASE_URL=
# AIOX_SUGGESTED: SUPABASE_SERVICE_ROLE_KEY=

# === AIOX Variables (added 2026-09-10) ===

# AIOX_NOTE: The following variables already exist with different values:
# AIOX_SUGGESTED: SUPABASE_URL=
# AIOX_SUGGESTED: SUPABASE_SERVICE_ROLE_KEY=
