# Normalize all text files to LF in the repo and working tree.
# This project deploys on Linux (Vercel) and uses shell hooks that must be LF.
* text=auto eol=lf

# Windows-only scripts stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts and git hooks must be LF to execute
*.sh   text eol=lf
*.cjs  text eol=lf
.husky/** text eol=lf

# Lockfiles: keep exactly as-is, never normalize or diff
bun.lock          -text -diff
package-lock.json -text -diff

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
